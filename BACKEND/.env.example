# ─── Base de datos ────────────────────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travelplannerbd

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Clave compartida con el frontend. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Tiene que ser IDÉNTICA a BACKEND_API_KEY del frontend.
API_KEY=cambiar_por_una_clave_larga_y_aleatoria

# Clave para operaciones de administración (ABM del catálogo de alojamientos).
# Dejala vacía para deshabilitar esas operaciones.
ADMIN_KEY=

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ─── Runtime ──────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=true
LOG_LEVEL=INFO

# Nota: el backend no habla con ninguna IA. La generación de itinerarios la hace
# el flujo de n8n, que llama el frontend (ver FRONTEND/.env.example).
