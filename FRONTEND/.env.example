# ─── Sesiones ─────────────────────────────────────────────────────────────────
# Generala con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria

# Poner en true sólo detrás de HTTPS.
SESSION_COOKIE_SECURE=false

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:5000
# Tiene que ser IDÉNTICA a API_KEY del backend.
BACKEND_API_KEY=cambiar_por_una_clave_larga_y_aleatoria
BACKEND_TIMEOUT=15

# ─── Runtime ──────────────────────────────────────────────────────────────────
PORT=8080
FLASK_DEBUG=true
LOG_LEVEL=INFO

# ─── Google OAuth (opcional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Generación de viajes con n8n ─────────────────────────────────────────────
# Es el único proveedor de IA del sistema. Si queda vacío o el flujo falla,
# se usa el generador local (sin IA) para que la web siga funcionando.
N8N_WEBHOOK_URL=
N8N_TOKEN=
N8N_TIMEOUT=120
