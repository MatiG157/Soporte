# ─── Sesiones ─────────────────────────────────────────────────────────────────
# Generala con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria

# Poner en true sólo detrás de HTTPS.
SESSION_COOKIE_SECURE=false

# ─── Backend ──────────────────────────────────────────────────────────────────
# 127.0.0.1 y no "localhost": en Windows localhost resuelve primero a ::1
# (IPv6), el servidor de Flask escucha solo en IPv4, y cada intento fallido
# cuesta ~2 segundos por peticion.
BACKEND_URL=http://127.0.0.1:5000
# Tiene que ser IDÉNTICA a API_KEY del backend.
BACKEND_API_KEY=cambiar_por_una_clave_larga_y_aleatoria
BACKEND_TIMEOUT=15

# ─── Runtime ──────────────────────────────────────────────────────────────────
PORT=8080
FLASK_DEBUG=true
LOG_LEVEL=INFO

# ─── Google OAuth (opcional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Generación de viajes con n8n ─────────────────────────────────────────────
# Es el único proveedor de IA del sistema. Si queda vacío o el flujo falla,
# se usa el generador local (sin IA) para que la web siga funcionando.
N8N_WEBHOOK_URL=
N8N_TIMEOUT=120

# La autenticacion depende de como este configurado el nodo Webhook en n8n.
#
# Opcion A - Basic Auth (Authentication = Basic Auth):
# N8N_BASIC_USER=usuario
# N8N_BASIC_PASSWORD=contrasena
#
# Opcion B - Header Auth (Authentication = Header Auth):
#   N8N_HEADER tiene que ser IDENTICO al campo `Name` de la credencial.
N8N_TOKEN=
N8N_HEADER=X-N8N-TOKEN
